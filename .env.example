# Supabase Project URL (find in: project settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon Key (find in: project settings → API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# Supabase Service Role Key (only for import script — NEVER expose client-side)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# --- Optioneel: spel-metadata verrijken ---------------------------------------
# Zonder deze variabelen werkt de app precies zoals hiervoor. Doosfoto's van
# BoardGameGeek worden gewoon opgehaald; alleen het automatisch schrijven van
# Nederlandse teksten voor nieuwe spellen staat dan uit.

# Claude API key. Alleen nodig als nieuwe spellen automatisch een Nederlandse
# omschrijving en speluitleg moeten krijgen. De bestaande spellen hebben die al
# uit migratie 011 en kosten dus niets.
# ANTHROPIC_API_KEY=sk-ant-...

# Alternatieve BoardGameGeek-URL. Handig om het ophaalpad lokaal te testen tegen
# een eigen server met vaste XML, zonder verkeer naar boardgamegeek.com.
# BGG_BASE_URL=https://boardgamegeek.com/xmlapi2

# Noodrem. Is deze gezet, dan eist /api/games/[id]/enrich de header
# x-enrich-token en is de knop in de app niet meer bruikbaar. Leeg laten tenzij
# er misbruik van de route wordt gemaakt.
# ENRICH_TOKEN=
